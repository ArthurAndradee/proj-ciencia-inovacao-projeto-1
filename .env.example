# Copie este arquivo para .env e preencha as chaves.
# Chaves do Google AI Studio (https://aistudio.google.com/apikey), separadas por
# vírgula. A cota do free tier é contada por projeto e por modelo, então chaves de
# projetos distintos somam cota; várias chaves do MESMO projeto não somam nada.
# As chamadas são distribuídas entre elas e, quando a cota de uma acaba, a rodada
# segue nas restantes em vez de parar.
GOOGLE_API_KEYS=

# Alternativa de chave única, ainda aceita quando GOOGLE_API_KEYS está vazia.
GOOGLE_API_KEY=

# Modelos usados em cada papel. Mantê-los iguais isola a variável arquitetural.
# Os modelos gemini-2.5-* estão fechados para chaves novas (404).
# Confira em https://aistudio.google.com quais modelos sua chave alcança.
GENERATOR_MODEL=gemini-3.7-flash
CRITIC_MODEL=gemini-3.7-flash

# Amostragem do experimento.
ARC_SPLIT=evaluation
SAMPLE_SIZE=100
SEED=20260814

# Orçamento fixo de chamadas à API por tarefa (Gerador + Crítico somados).
BUDGET_CALLS=12

# Parâmetros de geração. TEMPERATURE vale para a condição com Crítico; a condição
# de amostragem usa SAMPLING_TEMPERATURE, mais alta de propósito: sem diversidade
# entre as amostras, o best-of-N degenera em uma única tentativa repetida.
TEMPERATURE=0.2
SAMPLING_TEMPERATURE=0.8
MAX_OUTPUT_TOKENS=8192

# Limites de taxa. RPM vale POR CHAVE (cada projeto tem seu próprio teto), e
# RPM=0 desativa o throttle. Não confie no painel de limites do AI Studio: o
# valor real aparece no campo `limit:` da mensagem completa do erro 429.
# Com mais de uma chave, MAX_RETRIES cede lugar ao failover — insistir na mesma
# chave esgotada custa mais que passar para a próxima.
RPM=0
MAX_RETRIES=5

# Tempo máximo de uma requisição. Sem isso, uma conexão morta trava a
# execução indefinidamente: o socket fica esperando uma resposta que não vem.
REQUEST_TIMEOUT_S=180

# Execução do código gerado (sandbox local).
EXEC_TIMEOUT_S=10
EXEC_MEMORY_MB=1024

# Diretórios.
DATA_DIR=data
RESULTS_DIR=results
