# Copie este arquivo para .env e preencha a chave.
# Chave do Google AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Modelos usados em cada papel. Manter iguais isola a variavel arquitetural.
# gemini-2.5-flash e o modelo mais capaz disponivel no free tier.
GENERATOR_MODEL=gemini-2.5-flash
CRITIC_MODEL=gemini-2.5-flash

# Amostragem do experimento.
ARC_SPLIT=evaluation
SAMPLE_SIZE=100
SEED=20260814

# Orcamento fixo de chamadas a API por tarefa (Gerador + Critico somados).
BUDGET_CALLS=12

# Parametros de geracao.
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=8192

# Limites de taxa. RPM=0 desativa o throttle; no free tier, use o limite exato
# do seu projeto (visivel em https://aistudio.google.com/rate-limit).
RPM=0
MAX_RETRIES=5

# Execucao do codigo gerado (sandbox local).
EXEC_TIMEOUT_S=10
EXEC_MEMORY_MB=1024

# Diretorios.
DATA_DIR=data
RESULTS_DIR=results
